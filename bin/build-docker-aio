#!/bin/bash

# Default platform
PLATFORM="linux/amd64,linux/arm64"
PUSH=""

# Parse arguments
while [[ "$#" -gt 0 ]]; do
    case $1 in
        --push) PUSH="--push"; shift ;;
        --platform) PLATFORM="$2"; shift 2 ;;
        *) echo "Unknown parameter: $1"; exit 1 ;;
    esac
done

TAG=$(git rev-parse --abbrev-ref HEAD | tr '/' '-')

echo "Building multi-platform image for $PLATFORM (Tag: $TAG)..."

docker buildx build \
  --platform "$PLATFORM" \
  $PUSH \
  -t girish17/yojana:"$TAG" \
  --build-arg DEBIAN_BASE=bookworm \
  -f docker/prod/Dockerfile .

