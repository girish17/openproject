#!/bin/bash

PLATFORM="linux/amd64"
PUSH=""
BUILD_TYPE="all-in-one"

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --push) PUSH="--push"; shift ;;
        --platform) PLATFORM="$2"; shift 2 ;;
        --build-type) BUILD_TYPE="$2"; shift 2 ;;
        *) echo "Unknown parameter: $1"; exit 1 ;;
    esac
done

TAG="$(git rev-parse --abbrev-ref HEAD | tr '/' '-')-azure"

echo "Building x86 image for Azure (Tag: $TAG, Build: $BUILD_TYPE)..."

docker buildx build \
  --platform "$PLATFORM" \
  $PUSH \
  -t girish17/yojana:"$TAG" \
  --target "$BUILD_TYPE" \
  -f docker/prod/Dockerfile \
  --load .