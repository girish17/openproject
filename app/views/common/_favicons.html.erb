<% unless apply_custom_favicon? %>
  <% if Rails.application.config.assets.compile || Rails.env.development? %>
    <%= favicon_link_tag OpenProject::CustomStyles::Design.favicon_asset_path %>
  <% else %>
    <%= favicon_link_tag "/favicon.ico" %>
  <% end %>
<% end %>

<% unless apply_custom_touch_icon? %>
  <%# In the future we can add more sizes should we see 404 errors in the logs. %>
  <% if Rails.application.config.assets.compile || Rails.env.development? %>
    <%= favicon_link_tag OpenProject::CustomStyles::Design.apple_touch_icon_asset_path,
                         rel: "apple-touch-icon",
                         type: "image/png",
                         sizes: "120x120" %>
  <% else %>
    <%= favicon_link_tag "/apple-touch-icon-120x120.png",
                         rel: "apple-touch-icon",
                         type: "image/png",
                         sizes: "120x120" %>
  <% end %>
<% end %>
