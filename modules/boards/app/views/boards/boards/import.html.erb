<% html_title(t("boards.import.title")) -%>
<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("boards.import.title") }
    header.with_breadcrumbs(@project ? [{ href: project_overview_path(@project.id), text: @project.name }, { href: project_work_package_boards_path(@project), text: t("boards.label_boards") }, t("boards.import.title")] : nil)
  end
%>
<%= form_tag(import_project_work_package_boards_path(@project), multipart: true) do %>
  <div class="form--field">
    <label class="form--label"><%= t("boards.import.board_name") %></label>
    <div class="form--field-container">
      <%= text_field_tag :board_name, "", placeholder: t("boards.import.board_name_placeholder"), class: "form--text-field" %>
    </div>
  </div>
  <div class="form--field">
    <label class="form--label"><%= t("boards.import.select_file") %></label>
    <div class="form--field-container">
      <%= file_field_tag :csv_file, accept: ".csv", class: "form--file-field" %>
    </div>
  </div>
  <div class="form--field">
    <label class="form--label"></label>
    <div class="form--field-container">
      <p><%= t("boards.import.description") %></p>
    </div>
  </div>
  <div class="form--field">
    <label class="form--label"></label>
    <div class="form--field-container">
      <%= submit_tag t("boards.import.submit"), class: "button -primary" %>
      <%= link_to t(:button_cancel), project_work_package_boards_path(@project), class: "button" %>
    </div>
  </div>
<% end %>
