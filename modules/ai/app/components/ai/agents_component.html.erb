<div class="ai-agents" data-controller="ai--agents">
  <div class="ai-agents-header">
    <h2><%= I18n.t("ai.label_agents") %></h2>
    <button class="Button Button--primary"
            data-action="click->ai--agents#showForm"
            data-ai--agents-target="newButton">
      <span class="Button-label"><%= I18n.t("ai.button_new_agent") %></span>
    </button>
  </div>

  <div class="ai-agents-list" data-ai--agents-target="list">
    <p class="ai-agents-empty"><%= I18n.t("ai.no_agents") %></p>
  </div>

  <div class="ai-agents-form" data-ai--agents-target="form" hidden>
    <input type="hidden" data-ai--agents-target="agentId">
    <div class="FormControl">
      <label><%= Ai::Agent.human_attribute_name(:name) %></label>
      <input type="text" class="FormControl-input" data-ai--agents-target="nameInput" placeholder="<%= I18n.t('ai.placeholder_agent_name') %>">
    </div>
    <div class="FormControl">
      <label><%= I18n.t("ai.label_agent_type") %></label>
      <select class="FormControl-select" data-ai--agents-target="typeInput">
        <option value="custom"><%= I18n.t("ai.agent_type_custom") %></option>
        <option value="daily_summary"><%= I18n.t("ai.agent_type_daily_summary") %></option>
      </select>
    </div>
    <div class="FormControl">
      <label><%= I18n.t("ai.label_cron_expression") %></label>
      <input type="text" class="FormControl-input" data-ai--agents-target="cronInput" placeholder="<%= I18n.t('ai.placeholder_cron') %>">
    </div>
    <div class="FormControl">
      <label>Prompt</label>
      <textarea class="FormControl-input" data-ai--agents-target="promptInput" rows="4" placeholder="<%= I18n.t('ai.placeholder_agent_prompt') %>"></textarea>
    </div>
    <div class="FormControl">
      <label class="FormControl-label">
        <input type="checkbox" data-ai--agents-target="activeInput" checked>
        <%= I18n.t("ai.label_agent_active") %>
      </label>
    </div>
    <div class="ai-agents-form-actions">
      <button class="Button Button--primary" data-action="click->ai--agents#save">
        <span class="Button-label"><%= I18n.t("ai.button_save") %></span>
      </button>
      <button class="Button" data-action="click->ai--agents#cancelForm">
        <span class="Button-label">Cancel</span>
      </button>
    </div>
  </div>

  <div class="ai-agents-executions" data-ai--agents-target="executions" hidden>
    <h3><%= I18n.t("ai.label_agent_executions") %></h3>
    <div data-ai--agents-target="executionList"></div>
  </div>
</div>

<style>
  .ai-agents { padding: 20px; max-width: 800px; }
  .ai-agents-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .ai-agents-header h2 { margin: 0; font-size: 20px; }
  .ai-agents-list { margin-bottom: 20px; }
  .ai-agents-empty { color: var(--fgColor-muted, #656d76); text-align: center; padding: 40px; }
  .ai-agent-card {
    padding: 12px 16px; border: 1px solid var(--borderColor-default, #d0d7de);
    border-radius: 8px; margin-bottom: 8px; cursor: pointer;
    display: flex; justify-content: space-between; align-items: center;
  }
  .ai-agent-card:hover { background: var(--bgColor-muted, #f6f8fa); }
  .ai-agent-card.active { border-color: var(--fgColor-accent, #0969da); }
  .ai-agent-name { font-weight: 600; }
  .ai-agent-meta { font-size: 12px; color: var(--fgColor-muted, #656d76); }
  .ai-agent-status { font-size: 12px; padding: 2px 8px; border-radius: 12px; }
  .ai-agent-status.active { background: var(--bgColor-success-muted, #dafbe1); color: var(--fgColor-success, #1a7f37); }
  .ai-agent-status.inactive { background: var(--bgColor-muted, #f6f8fa); color: var(--fgColor-muted, #656d76); }
  .ai-agent-delete { cursor: pointer; color: var(--fgColor-danger, #cf222e); font-size: 18px; padding: 4px; }
  .ai-agents-form { border: 1px solid var(--borderColor-default, #d0d7de); border-radius: 8px; padding: 20px; margin-bottom: 20px; }
  .ai-agents-form .FormControl { margin-bottom: 12px; }
  .ai-agents-form label { display: block; margin-bottom: 4px; font-weight: 500; font-size: 14px; }
  .ai-agents-form-actions { display: flex; gap: 8px; margin-top: 16px; }
  .ai-agents-executions { border-top: 1px solid var(--borderColor-default, #d0d7de); padding-top: 16px; margin-top: 16px; }
  .ai-execution-item { padding: 8px 0; border-bottom: 1px solid var(--borderColor-muted, #e8eaed); font-size: 13px; display: flex; gap: 12px; }
  .ai-execution-status { font-weight: 500; }
  .ai-execution-status.completed { color: var(--fgColor-success, #1a7f37); }
  .ai-execution-status.failed { color: var(--fgColor-danger, #cf222e); }
  .ai-execution-status.running { color: var(--fgColor-attention, #9a6700); }
</style>
